# =============================================================================
# BugDNA — Nginx reverse proxy
# =============================================================================
# One public entry point in front of three private services:
#
#   /            -> web        (Next.js, :3000)
#   /api/        -> api        (Express, :4000)
#   /socket.io/  -> api        (Socket.io, :4000, websocket upgrade)
#
# The Python risk service is deliberately absent. It accepts feature vectors and
# has no business being reachable from the internet; it stays on the internal
# Docker network and is only ever called by the API.
#
# TLS: `certbot --nginx` rewrites this file in place to add the 443 server block
# and the redirect. See infra/ec2/setup-tls.sh.
# =============================================================================

# --- upstreams --------------------------------------------------------------
# Named upstreams rather than inline proxy_pass targets, so keepalive can be
# configured. Without keepalive, every proxied request opens a new TCP
# connection to the backend, which is measurable under load.

upstream bugdna_web {
    server web:3000;
    keepalive 32;
}

upstream bugdna_api {
    server api:4000;
    keepalive 32;
}

# --- rate limiting ----------------------------------------------------------
# A coarse edge limit. The API applies its own per-user limits in Redis; this one
# exists to shed obvious floods before they reach Node at all.
limit_req_zone $binary_remote_addr zone=bugdna_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=bugdna_auth:10m rate=2r/s;

# Cache zone for Next.js immutable build assets.
proxy_cache_path /var/cache/nginx/bugdna
                 levels=1:2
                 keys_zone=bugdna_static:20m
                 max_size=500m
                 inactive=7d
                 use_temp_path=off;

server {
    listen 80;
    listen [::]:80;

    # Replaced by the real hostname during deployment. `_` matches any host,
    # which is what makes this work on a bare EC2 public DNS name.
    server_name ${BUGDNA_SERVER_NAME};

    # --- limits -------------------------------------------------------------
    # The largest legitimate request body is a merge-decision justification.
    # Diffs are fetched from GitHub server-side, never uploaded.
    client_max_body_size 2m;
    client_body_timeout 30s;
    client_header_timeout 30s;

    # --- security headers ---------------------------------------------------
    # Set at the edge so they apply even to responses from a service that forgot.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Don't advertise the version.
    server_tokens off;

    # --- compression --------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml
        font/woff2;

    # --- logging ------------------------------------------------------------
    # Includes the request id so an edge log line can be joined to the
    # corresponding API log line.
    log_format bugdna_combined
        '$remote_addr - $remote_user [$time_local] "$request" '
        '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
        'rt=$request_time urt=$upstream_response_time rid=$http_x_request_id';

    access_log /var/log/nginx/bugdna.access.log bugdna_combined;
    error_log  /var/log/nginx/bugdna.error.log warn;

    # ------------------------------------------------------------------------
    # Health check — answered by Nginx itself
    # ------------------------------------------------------------------------
    # Deliberately not proxied: a load balancer asking "is the edge up" should
    # not get a 502 because a backend is mid-restart.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # ------------------------------------------------------------------------
    # Socket.io — realtime analysis progress
    # ------------------------------------------------------------------------
    # Must come before /api/ so the upgrade headers are applied.
    location /socket.io/ {
        proxy_pass http://bugdna_api;
        proxy_http_version 1.1;

        # The three lines that make websockets work through a proxy. Without
        # them the client silently falls back to long-polling.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A websocket is idle by design between events. The default 60s read
        # timeout would tear down a healthy connection watching a slow analysis.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Buffering breaks the point of a realtime stream.
        proxy_buffering off;
    }

    # ------------------------------------------------------------------------
    # Auth endpoints — tighter rate limit
    # ------------------------------------------------------------------------
    location /api/v1/auth/ {
        limit_req zone=bugdna_auth burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://bugdna_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $http_x_request_id;

        # The OAuth callback redirects to the app; Nginx must not rewrite it.
        proxy_redirect off;
        proxy_read_timeout 60s;
    }

    # ------------------------------------------------------------------------
    # API
    # ------------------------------------------------------------------------
    location /api/ {
        limit_req zone=bugdna_general burst=60 nodelay;
        limit_req_status 429;

        proxy_pass http://bugdna_api;
        proxy_http_version 1.1;
        # Empty Connection header enables upstream keepalive.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $http_x_request_id;

        # Analyses are queued, not awaited, so no API call should be slow. 65s
        # leaves headroom for a GitHub round trip on the diff endpoint.
        proxy_connect_timeout 5s;
        proxy_send_timeout 65s;
        proxy_read_timeout 65s;

        # Never cache API responses: they are per-user and mutable.
        proxy_cache off;
        add_header Cache-Control "no-store" always;
    }

    # ------------------------------------------------------------------------
    # Next.js immutable build assets
    # ------------------------------------------------------------------------
    # Content-hashed filenames, so they can be cached hard at the edge.
    location /_next/static/ {
        proxy_pass http://bugdna_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;

        proxy_cache bugdna_static;
        proxy_cache_valid 200 7d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status;

        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /_next/image {
        proxy_pass http://bugdna_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;

        proxy_cache bugdna_static;
        proxy_cache_valid 200 30d;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # ------------------------------------------------------------------------
    # Everything else — the Next.js app
    # ------------------------------------------------------------------------
    location / {
        limit_req zone=bugdna_general burst=60 nodelay;

        proxy_pass http://bugdna_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;

        # Serve the last good page if the app is restarting, rather than a 502.
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # Deny access to dotfiles that should never be served.
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
    }
}
