# =============================================================================
# BugDNA — environment configuration
# =============================================================================
# Copy to `.env` and fill in the blanks:  cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
#
# This single file feeds all three services via docker-compose. When running a
# service natively (outside Docker), copy the relevant block into
# backend/.env, frontend/.env.local or ml-service/.env.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
# Public origin of the browser-facing app. Used for OAuth redirects + CORS.
APP_URL=http://localhost:3000
# Public origin of the API as reached from the browser.
API_URL=http://localhost:4000
LOG_LEVEL=debug
# `pretty` for human-readable dev logs, `json` for production/structured logs.
LOG_FORMAT=pretty

# -----------------------------------------------------------------------------
# PostgreSQL  (primary system of record)
# -----------------------------------------------------------------------------
POSTGRES_USER=bugdna
POSTGRES_PASSWORD=bugdna_local_password
POSTGRES_DB=bugdna
POSTGRES_PORT=5432
# Host-side connection string (native dev). Inside docker-compose the API
# overrides the host to `postgres`.
DATABASE_URL=postgresql://bugdna:bugdna_local_password@localhost:5432/bugdna?schema=public

# -----------------------------------------------------------------------------
# Redis  (cache, transient analysis state, BullMQ job coordination)
# Redis is deliberately NOT a source of truth — see docs/Architecture.md.
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of browser origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000

# Signs the session JWT stored in an httpOnly cookie.
#   generate:  openssl rand -hex 48
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_48
SESSION_TTL_HOURS=168
COOKIE_NAME=bugdna_session
# Set to `true` only when served over HTTPS.
COOKIE_SECURE=false
# Leave blank for localhost; set to e.g. `.bugdna.io` to share across subdomains.
COOKIE_DOMAIN=

# AES-256-GCM key used to encrypt GitHub access tokens at rest.
# MUST be exactly 64 hex characters (32 bytes).
#   generate:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# GitHub OAuth App
# -----------------------------------------------------------------------------
# Create at: https://github.com/settings/developers  ->  New OAuth App
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://localhost:4000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user,user:email,repo

# `live`  = talk to api.github.com (needs the OAuth app above)
# `mock`  = serve deterministic fixtures, no network, no credentials
GITHUB_MODE=live
GITHUB_API_BASE=https://api.github.com
# Optional fallback PAT used ONLY for unauthenticated/system calls to raise the
# rate limit. Never used to read a user's private data on their behalf.
GITHUB_SYSTEM_TOKEN=

# Hard caps so a pathological PR cannot exhaust memory or rate limit.
GITHUB_MAX_FILES_PER_PR=300
GITHUB_MAX_PATCH_BYTES=120000
GITHUB_REQUEST_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# ML risk service (Python / FastAPI)
# -----------------------------------------------------------------------------
ML_PORT=8000
# As reached from the backend. docker-compose overrides host to `ml-service`.
ML_SERVICE_URL=http://localhost:8000
# Shared secret for backend -> ML calls. The ML service is internal-only and is
# never exposed through Nginx.
ML_SERVICE_TOKEN=CHANGE_ME_internal_shared_secret
ML_REQUEST_TIMEOUT_MS=20000
ML_MAX_RETRIES=2

# ML service's own view of itself
MODEL_DIR=/app/models
MODEL_NAME=bugdna-risk
# Pinned artifact version the service loads. `latest` resolves the newest.
MODEL_VERSION=latest
# If the model artifact is missing/unloadable, fall back to the transparent
# heuristic scorer instead of failing the request. See docs/ML_MODEL.md.
ALLOW_HEURISTIC_FALLBACK=true
SHAP_MAX_FEATURES_RETURNED=12

# -----------------------------------------------------------------------------
# Analysis pipeline / worker
# -----------------------------------------------------------------------------
ANALYSIS_QUEUE_NAME=bugdna:analysis
ANALYSIS_CONCURRENCY=4
ANALYSIS_JOB_ATTEMPTS=3
ANALYSIS_JOB_BACKOFF_MS=4000
ANALYSIS_TIMEOUT_MS=120000
# Risk score (0-100) at or above which a PR is treated as noteworthy and
# triggers a high-risk notification.
HIGH_RISK_NOTIFY_THRESHOLD=70

# -----------------------------------------------------------------------------
# Caching TTLs (seconds)
# -----------------------------------------------------------------------------
CACHE_TTL_REPOS=300
CACHE_TTL_PULLS=120
CACHE_TTL_DIFF=900
CACHE_TTL_ANALYTICS=180

# -----------------------------------------------------------------------------
# Rate limiting (per IP / per session)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_ANALYSIS_MAX=30

# -----------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_* is inlined into the browser bundle — no secrets here)
# -----------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=BugDNA
NEXT_PUBLIC_ENABLE_DEMO_BANNER=true

# -----------------------------------------------------------------------------
# Seed / demo tenant
# -----------------------------------------------------------------------------
# `npm run seed` in backend/ creates this account with synthetic but realistic
# repos, PRs, analyses, deployments and notifications so the UI is never empty.
SEED_DEMO_EMAIL=demo@bugdna.dev
SEED_DEMO_LOGIN=bugdna-demo

# Allows the "Try the demo" button to sign in as the seeded demo account
# without GitHub credentials. The demo user can only ever see seeded data.
ENABLE_DEMO_LOGIN=true
